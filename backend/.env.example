# PostgreSQL local (plan B sin Docker): ver scripts/pg.ps1
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/agenda_dev
JWT_SECRET=cambia-esto-en-produccion-por-al-menos-32-bytes-aleatorios
JWT_TTL_DIAS=30
FRONTEND_ORIGIN=http://localhost:5173

# --- Recordatorios automáticos ---
# 'simulado' no abre la red: guarda lo que habría mandado. Es el defecto para que un despliegue
# nuevo no escriba a pacientes antes de tener SMTP. Cambiar a 'smtp' exige SMTP_HOST y SMTP_DE.
RECORDATORIOS_PROVEEDOR=simulado
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
# Remitente real: muchos proveedores rechazan un "From" que no es la cuenta autenticada.
SMTP_DE=
# true para SSL directo (puerto 465); false usa STARTTLS en 587.
SMTP_SSL=false
# Lo que manda el cron externo en la cabecera 'x-cron-secret'. Apaga las DOS rutas internas
# (`/internal/recordatorios` y `/internal/limpieza`): sin valor responden 503. No es un detalle de
# configuración, es el interruptor; una de ellas borra el histórico del consultorio.
CRON_SECRET=
